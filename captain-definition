{
    "schemaVersion": 2,
    "dockerfileLines": [
        "FROM node:24.10.0-bookworm-slim",
        "WORKDIR /usr/src/app",
        "COPY package.json package-lock.json ./",
        "RUN npm ci --omit=dev --include=optional",
        "RUN node -p \"process.platform + ' ' + process.arch\"",
        "RUN npm list sharp",
        "RUN npm list @img/sharp-linux-x64 || true",
        "RUN npm list @img/sharp-libvips-linux-x64 || true",
        "RUN ls -la node_modules/@img || true",
        "RUN node -e \"const sharp=require('sharp'); console.log('Sharp OK', sharp.versions)\"",
        "COPY . .",
        "ENV NODE_ENV=production",
        "ENV PORT=80",
        "EXPOSE 80",
        "CMD [\"npm\", \"start\"]"
    ]
}