{
    "schemaVersion": 2,
    "dockerfileLines": [
        "FROM node:24.10.0-bookworm-slim",
        "WORKDIR /usr/src/app",
        "COPY package.json package-lock.json ./",
        "RUN npm ci --omit=dev",
        "RUN npm install --os=linux --cpu=x64 sharp@0.35.3",
        "RUN node -e \"const sharp=require('sharp'); console.log('Sharp OK', sharp.versions)\"",
        "COPY . .",
        "ENV NODE_ENV=production",
        "ENV PORT=80",
        "EXPOSE 80",
        "CMD [\"npm\", \"start\"]"
    ]
}