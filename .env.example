APP_NAME=SysEvents API
NODE_ENV=development
# En produccion, el valor inyectado por la plataforma tiene prioridad sobre este archivo.
# Si la plataforma asigna un puerto dinamico, lo publicara normalmente como PORT.
SERVER_HOST=0.0.0.0
PORT=3000

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_PUBLIC_URL=http://localhost:5173
APP_API_URL=http://localhost:3000

JWT_SECRET=change_this_secret_in_development
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
APP_SECRETS_KEY=change_this_persistent_encryption_secret

DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=change_this_password
DB_NAME=sysevents_db
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true


STRIPE_SECRET_KEY=sk_test_change_this
STRIPE_WEBHOOK_SECRET=whsec_change_this
MERCADOPAGO_ACCESS_TOKEN=

FILE_STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/png,image/jpeg,image/webp,application/zip,application/x-zip-compressed,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sysevents.local

# Optional aliases used by some ULV/Gmail-style SMTP setups.
# SMTP_USER falls back to AUTH_EMAIL, SMTP_PASSWORD falls back to AUTH_PASS_APP then AUTH_PASS,
# and SMTP_FROM falls back to AUTH_EMAIL.
AUTH_EMAIL=xxxxx@ulv.edu.mx
AUTH_PASS=xxxxxx
AUTH_PASS_APP=xxxxxxxxx

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_MAX_REQUESTS=5
TEST_DB_NAME=sysevents_test_db
